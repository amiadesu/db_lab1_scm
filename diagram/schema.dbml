// Система управління ланцюгами постачання
Project supply_chain {
  database_type: 'PostgreSQL'
  Note: 'SCM: закупівлі, склади, продажі, доставка'
}

Enum movement_type {
  receipt
  issue
  adjustment
}

Enum po_status {
  draft
  approved
  sent
  partially_received
  received
  cancelled
}

Enum shipment_status {
  planned
  in_transit
  delivered
  lost
  returned
}

Enum so_status {
  new
  confirmed
  picking
  shipped
  delivered
  cancelled
}

TableGroup "Системні таблиці" {
  roles
  users
  countries
  cities
  units_of_measure
  product_categories
}

TableGroup "Постачання" {
  suppliers
  supplier_bank_details
  supplier_contacts
  supplier_products
  purchase_orders
  purchase_order_items
}

TableGroup "Склад" {
  products
  product_attributes
  warehouses
  inventory
  inventory_movements
}

TableGroup "Продажі та доставка" {
  customers
  sales_orders
  sales_order_items
  carriers
  carrier_contracts
  shipments
}

TableGroup "Аудит" {
  audit_log
}

Table roles {
  role_id integer [pk, increment]
  name varchar(50) [not null, unique]
  description varchar(255)
}

Table users {
  user_id integer [pk, increment]
  role_id integer [not null, ref: > roles.role_id]
  login varchar(50) [not null, unique]
  last_name varchar(60) [not null]
  first_name varchar(60) [not null]
  middle_name varchar(60)
  email email_address [not null, unique]
  is_active boolean [not null, default: `true`]
  created_at timestamptz [not null, default: `now()`]
}

Table countries {
  country_code country_code [pk]
  name varchar(100) [not null, unique]
}

Table cities {
  city_id integer [pk, increment]
  country_code country_code [not null, ref: > countries.country_code]
  name varchar(100) [not null]
  region varchar(100)

  indexes {
    country_code [type: btree, name: 'ix_cities_country', note: 'BTREE']
  }
  Note: '3НФ: місто визначає країну'
}

Table units_of_measure {
  uom_id integer [pk, increment]
  code varchar(10) [not null, unique]
  name varchar(50) [not null]
}

Table product_categories {
  category_id integer [pk, increment]
  parent_category_id integer [ref: > product_categories.category_id]
  name varchar(100) [not null, unique]
}

Table suppliers {
  supplier_id integer [pk, increment]
  name varchar(200) [not null]
  tax_code varchar(20) [not null]
  city_id integer [not null, ref: > cities.city_id]
  street varchar(150)
  building varchar(20)
  postal_code varchar(12)
  phone phone_number
  email email_address
  rating numeric(3,2)
  lead_time_days integer [not null, default: `7`]
  created_at timestamptz [not null, default: `now()`]
  created_by integer [note: 'FK -> users.user_id']
  updated_at timestamptz [not null, default: `now()`]
  updated_by integer [note: 'FK -> users.user_id']
  is_deleted boolean [not null, default: `false`]
  deleted_at timestamptz
  deleted_by integer [note: 'FK -> users.user_id']

  indexes {
    city_id [type: btree, name: 'ix_suppliers_city', note: 'BTREE']
    `lower((email)::text)` [type: btree, name: 'ix_suppliers_email_lower', note: 'BTREE']
    tax_code [unique, type: btree, name: 'ux_suppliers_tax_code_active', note: 'BTREE WHERE (NOT is_deleted)']
  }
  Note: 'SOFT DELETE + AUDIT (updated_at/updated_by)'
}

Table supplier_bank_details {
  supplier_id integer [pk, ref: - suppliers.supplier_id]
  bank_name varchar(150) [not null]
  iban iban_code [not null, unique]
  swift_code swift_code
  currency currency_code [not null, default: `'UAH'`]
  Note: 'Зв\'язок 1-до-1 з suppliers (PK = FK)'
}

Table supplier_contacts {
  contact_id integer [pk, increment]
  supplier_id integer [not null, ref: > suppliers.supplier_id]
  last_name varchar(60) [not null]
  first_name varchar(60) [not null]
  middle_name varchar(60)
  position varchar(100)
  phone phone_number
  email email_address
  is_primary boolean [not null, default: `false`]

  indexes {
    supplier_id [type: btree, name: 'ix_supplier_contacts_supp', note: 'BTREE']
    supplier_id [unique, type: btree, name: 'ux_supplier_contacts_primary', note: 'BTREE WHERE is_primary']
  }
}

Table supplier_products {
  supplier_id integer [not null, ref: > suppliers.supplier_id]
  product_id integer [not null, ref: > products.product_id]
  supplier_sku varchar(40)
  purchase_price numeric(12,2) [not null]
  min_order_qty integer [not null, default: `1`]

  indexes {
    (supplier_id, product_id) [pk]
    supplier_sku [type: hash, name: 'hx_supplier_products_supplier_sku', note: 'HASH']
    product_id [type: btree, name: 'ix_supplier_products_prod', note: 'BTREE']
  }
}

Table purchase_orders {
  po_id integer [pk, increment]
  po_number varchar(20) [not null, unique]
  supplier_id integer [not null, ref: > suppliers.supplier_id]
  warehouse_id integer [not null, ref: > warehouses.warehouse_id]
  status po_status [not null, default: `'draft'.po_status`]
  order_date date [not null, default: `CURRENT_DATE`]
  expected_date date
  currency currency_code [not null, default: `'UAH'`]
  created_at timestamptz [not null, default: `now()`]
  created_by integer [note: 'FK -> users.user_id']
  updated_at timestamptz [not null, default: `now()`]
  updated_by integer [note: 'FK -> users.user_id']

  indexes {
    (status, expected_date) [type: btree, name: 'ix_po_open_status', note: 'BTREE WHERE (status = ANY (ARRAY[draft::scm.po_status, approved::scm.po_status, sent::scm.po_status, partially_received::scm.po_status]))']
    `supplier_id, order_date DESC` [type: btree, name: 'ix_po_supplier_date', note: 'BTREE']
  }
  Note: 'AUDIT; сума рахується у v_purchase_orders (3НФ)'
}

Table purchase_order_items {
  po_item_id integer [pk, increment]
  po_id integer [not null, ref: > purchase_orders.po_id]
  product_id integer [not null, ref: > products.product_id]
  quantity integer [not null]
  unit_price numeric(12,2) [not null]
  received_qty integer [not null, default: `0`]
  line_total numeric(14,2) [note: 'GENERATED: ((quantity)::numeric * unit_price)']

  indexes {
    `line_total DESC` [type: btree, name: 'ix_po_items_line_total', note: 'BTREE']
    product_id [type: btree, name: 'ix_po_items_product', note: 'BTREE']
  }
}

Table products {
  product_id integer [pk, increment]
  sku item_code [not null]
  name varchar(200) [not null]
  description text
  category_id integer [not null, ref: > product_categories.category_id]
  uom_id integer [not null, ref: > units_of_measure.uom_id]
  unit_price numeric(12,2) [not null]
  weight_kg numeric(10,3)
  reorder_level integer [not null, default: `0`]
  search_vector tsvector [note: 'GENERATED: to_tsvector(simple::regconfig, (((COALESCE(name, ::character varying))::text ||  ::text) || COALESCE(description, ::text)))']
  created_at timestamptz [not null, default: `now()`]
  created_by integer [note: 'FK -> users.user_id']
  updated_at timestamptz [not null, default: `now()`]
  updated_by integer [note: 'FK -> users.user_id']
  is_deleted boolean [not null, default: `false`]
  deleted_at timestamptz
  deleted_by integer [note: 'FK -> users.user_id']

  indexes {
    `name gin_trgm_ops` [name: 'gx_products_name_trgm', note: 'GIN']
    search_vector [name: 'gx_products_search', note: 'GIN']
    category_id [type: btree, name: 'ix_products_category', note: 'BTREE']
    sku [unique, type: btree, name: 'ux_products_sku_active', note: 'BTREE WHERE (NOT is_deleted)']
  }
  Note: 'SOFT DELETE + AUDIT; search_vector - GENERATED tsvector'
}

Table product_attributes {
  product_id integer [not null, ref: > products.product_id]
  attr_name varchar(50) [not null]
  attr_value varchar(200) [not null]

  indexes {
    (product_id, attr_name) [pk]
    (attr_name, attr_value) [type: btree, name: 'ix_product_attr_value', note: 'BTREE']
  }
  Note: '1НФ: характеристика = окремий кортеж'
}

Table warehouses {
  warehouse_id integer [pk, increment]
  code item_code [not null]
  name varchar(150) [not null]
  city_id integer [not null, ref: > cities.city_id]
  street varchar(150)
  building varchar(20)
  location point
  capacity_m3 numeric(12,2)
  manager_id integer [ref: > users.user_id]
  created_at timestamptz [not null, default: `now()`]
  created_by integer [note: 'FK -> users.user_id']
  updated_at timestamptz [not null, default: `now()`]
  updated_by integer [note: 'FK -> users.user_id']
  is_deleted boolean [not null, default: `false`]
  deleted_at timestamptz
  deleted_by integer [note: 'FK -> users.user_id']

  indexes {
    city_id [type: btree, name: 'ix_warehouses_city', note: 'BTREE']
    location [name: 'sx_warehouses_location', note: 'GIST']
    code [unique, type: btree, name: 'ux_warehouses_code_active', note: 'BTREE WHERE (NOT is_deleted)']
  }
  Note: 'SOFT DELETE + AUDIT; location - GiST'
}

Table inventory {
  warehouse_id integer [not null, ref: > warehouses.warehouse_id]
  product_id integer [not null, ref: > products.product_id]
  qty_on_hand integer [not null, default: `0`]
  qty_reserved integer [not null, default: `0`]
  updated_at timestamptz [not null, default: `now()`]
  updated_by integer [note: 'FK -> users.user_id']

  indexes {
    (warehouse_id, product_id) [pk]
    `product_id) INCLUDE (qty_on_hand, qty_reserved` [type: btree, name: 'ix_inventory_product_cover', note: 'BTREE INCLUDE']
  }
  Note: 'AUDIT; qty_on_hand оновлюється тригером з inventory_movements'
}

Table inventory_movements {
  movement_id bigint [pk, increment]
  warehouse_id integer [not null, ref: > warehouses.warehouse_id]
  product_id integer [not null, ref: > products.product_id]
  movement_type movement_type [not null]
  quantity integer [not null]
  po_id integer [ref: > purchase_orders.po_id]
  so_id integer [ref: > sales_orders.so_id]
  note varchar(255)
  created_at timestamptz [not null, default: `now()`]
  created_by integer [note: 'FK -> users.user_id']

  indexes {
    created_at [name: 'bx_inventory_movements_created', note: 'BRIN']
    po_id [type: btree, name: 'ix_movements_po', note: 'BTREE WHERE (po_id IS NOT NULL)']
    so_id [type: btree, name: 'ix_movements_so', note: 'BTREE WHERE (so_id IS NOT NULL)']
    (warehouse_id, product_id, created_at) [type: btree, name: 'ix_movements_wh_product', note: 'BTREE']
  }
  Note: 'CLUSTER ON ix_movements_wh_product'
}

Table customers {
  customer_id integer [pk, increment]
  name varchar(200) [not null]
  tax_code varchar(20)
  city_id integer [not null, ref: > cities.city_id]
  street varchar(150)
  building varchar(20)
  email email_address
  phone phone_number
  credit_limit numeric(14,2) [not null, default: `0`]
  created_at timestamptz [not null, default: `now()`]
  created_by integer [note: 'FK -> users.user_id']
  updated_at timestamptz [not null, default: `now()`]
  updated_by integer [note: 'FK -> users.user_id']
  is_deleted boolean [not null, default: `false`]
  deleted_at timestamptz
  deleted_by integer [note: 'FK -> users.user_id']

  indexes {
    city_id [type: btree, name: 'ix_customers_city', note: 'BTREE']
    `lower((email)::text)` [type: btree, name: 'ix_customers_email_lower', note: 'BTREE']
  }
  Note: 'SOFT DELETE + AUDIT'
}

Table sales_orders {
  so_id integer [pk, increment]
  so_number varchar(20) [not null, unique]
  customer_id integer [not null, ref: > customers.customer_id]
  warehouse_id integer [not null, ref: > warehouses.warehouse_id]
  status so_status [not null, default: `'new'.so_status`]
  order_date date [not null, default: `CURRENT_DATE`]
  required_date date
  created_at timestamptz [not null, default: `now()`]
  created_by integer [note: 'FK -> users.user_id']
  updated_at timestamptz [not null, default: `now()`]
  updated_by integer [note: 'FK -> users.user_id']

  indexes {
    `customer_id, order_date DESC` [type: btree, name: 'ix_so_customer_date', note: 'BTREE']
  }
  Note: 'AUDIT; сума рахується у v_sales_orders (3НФ)'
}

Table sales_order_items {
  so_item_id integer [pk, increment]
  so_id integer [not null, ref: > sales_orders.so_id]
  product_id integer [not null, ref: > products.product_id]
  quantity integer [not null]
  unit_price numeric(12,2) [not null]
  discount_pct numeric(5,2) [not null, default: `0`]
  line_total numeric(14,2) [note: 'GENERATED: round((((quantity)::numeric * unit_price) * ((1)::numeric - (discount_pct / (100)::numeric))), 2)']

  indexes {
    product_id [type: btree, name: 'ix_so_items_product', note: 'BTREE']
  }
}

Table carriers {
  carrier_id integer [pk, increment]
  name varchar(150) [not null]
  transport_mode varchar(20) [not null]
  phone phone_number
  email email_address
  is_deleted boolean [not null, default: `false`]
  deleted_at timestamptz
  deleted_by integer [note: 'FK -> users.user_id']
  Note: 'SOFT DELETE'
}

Table carrier_contracts {
  contract_id integer [pk, increment]
  carrier_id integer [not null, ref: > carriers.carrier_id]
  valid_period daterange [not null]
  rate_per_kg numeric(10,2) [not null]
  Note: 'EXCLUDE USING gist: періоди одного перевізника не перетинаються'
}

Table shipments {
  shipment_id integer [pk, increment]
  so_id integer [not null, ref: > sales_orders.so_id]
  carrier_id integer [not null, ref: > carriers.carrier_id]
  tracking_number varchar(50) [unique]
  status shipment_status [not null, default: `'planned'.shipment_status`]
  shipped_at timestamptz
  delivered_at timestamptz
  shipping_cost numeric(12,2) [not null, default: `0`]
  created_at timestamptz [not null, default: `now()`]
  created_by integer [note: 'FK -> users.user_id']
  updated_at timestamptz [not null, default: `now()`]
  updated_by integer [note: 'FK -> users.user_id']

  indexes {
    so_id [type: btree, name: 'ix_shipments_so', note: 'BTREE']
  }
  Note: 'AUDIT'
}

Table audit_log {
  audit_id bigint [not null, increment]
  table_name varchar(63) [not null]
  record_id text [not null]
  operation varchar(10) [not null]
  old_data jsonb
  new_data jsonb
  changed_by integer [note: 'FK -> users.user_id']
  changed_at timestamptz [not null, default: `now()`]

  indexes {
    (audit_id, changed_at) [pk]
    `new_data jsonb_path_ops` [name: 'gx_audit_log_new_data', note: 'GIN']
    (table_name, record_id) [type: btree, name: 'ix_audit_log_record', note: 'BTREE']
  }
  Note: 'PARTITION BY RANGE (changed_at): audit_log_2026, audit_log_2027, audit_log_default'
}
